{
    "name": "Claude & Gemini & TypeScript Dev",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
    // 認証情報を含む設定ファイル (.claude.json) をボリューム内に置き、リビルド後も認証を維持する
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude"
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "mounts": [
        {
            "source": "claude-config",
            "target": "/home/node/.claude",
            "type": "volume"
        },
        {
            "source": "gemini-config",
            "target": "/home/node/.gemini",
            "type": "volume"
        },
        {
            "source": "codex-config",
            "target": "/home/node/.codex",
            "type": "volume"
        },
        {
            "source": "gh-config",
            "target": "/home/node/.config/gh",
            "type": "volume"
        }
    ],
    // Docker起動時に .env ファイルを読み込ませる設定
    "runArgs": [
        "--env-file",
        ".env"
    ],
    "customizations": {
        "vscode": {
            // コンテナ起動時に自動で入れたいVS Code拡張機能
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-vscode.vscode-typescript-next"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    // コンテナユーザーをnode(非root)に設定
    "remoteUser": "node",
    // コンテナ作成後に実行されるコマンド
    // ここでGemini CLIをグローバルインストールします
    "postCreateCommand": "bash .devcontainer/setup.sh"
}