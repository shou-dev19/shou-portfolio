{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/**'",
  "rewrites": [
    {
      "source": "/",
      "destination": "/portfolio"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/portfolio/:path*"
    }
  ]
}
